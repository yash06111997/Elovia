# Server environment variables.
#
# These are SECRETS. They belong in your host's environment/secrets panel and
# must never be committed, never appear in eas.json, and never ship inside the
# mobile app. Copy this file to .env for local development only.
#
# The mobile app's own EXPO_PUBLIC_* values are a separate thing entirely: they
# are client identifiers, they live in artifacts/mobile/eas.json, and they are
# baked into the app binary at build time.


# ---------------------------------------------------------------------------
# REQUIRED - the server will not work without these
# ---------------------------------------------------------------------------

# Postgres connection string.
# Railway injects this automatically when you add a Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port to listen on. Railway sets this automatically; only needed locally.
PORT=8080

# Firebase Admin service account, as a single-line JSON string.
#
# Firebase console -> Project settings -> Service accounts ->
# Generate new private key. Paste the ENTIRE downloaded .json file here.
#
# Without this the server cannot verify login tokens, so every authenticated
# route returns 401 and the app appears broken rather than unconfigured.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Must match the Firebase project the mobile app authenticates against.
FIREBASE_PROJECT_ID=fitness-app-e0aab


# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# Anthropic. Required for food photo recognition - Claude is the only
# vision-capable model in the routing table - and acts as the fallback for
# plan generation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# NVIDIA NIM. Optional but strongly recommended: structured generation
# (workouts, meal plans, recipes) routes here first at roughly a tenth of the
# token cost, falling back to Claude on failure. https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# Optional overrides.
# NVIDIA_NIM_STRUCTURED_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct

# Set to 1 to send structured generation to Claude instead of NIM. Useful for
# comparing output quality against the cost saving on real traffic.
# AI_PREFER_QUALITY=0


# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

# A long random string that you invent. Set the SAME value as the
# Authorization header in RevenueCat -> Integrations -> Webhooks, pointing at
# https://<your-domain>/api/webhooks/revenuecat
#
# Without it the webhook rejects every delivery, so no purchase ever grants
# server-side access and paying users are treated as free.
REVENUECAT_WEBHOOK_SECRET=invent-a-long-random-string-here


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Expo push access token. Without it push still works, but anyone who learns a
# device token could send notifications to that device.
# https://expo.dev/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# NODE_ENV=production
