# Server environment variables.
#
# These are SECRETS. They belong in your host's environment/secrets panel and
# must never be committed, never appear in eas.json, and never ship inside the
# mobile app. Copy this file to .env for local development only.
#
# The mobile app's own EXPO_PUBLIC_* values are a separate thing entirely: they
# are client identifiers, they live in artifacts/mobile/eas.json, and they are
# baked into the app binary at build time.


# ---------------------------------------------------------------------------
# REQUIRED - the server will not work without these
# ---------------------------------------------------------------------------

# Postgres connection string.
# Railway injects this automatically when you add a Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port to listen on. Railway sets this automatically; only needed locally.
PORT=8080

# Firebase Admin service account, as a single-line JSON string.
#
# Firebase console -> Project settings -> Service accounts ->
# Generate new private key. Paste the ENTIRE downloaded .json file here.
#
# Without this the server cannot verify login tokens, so every authenticated
# route returns 401 and the app appears broken rather than unconfigured.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Must match the Firebase project the mobile app authenticates against.
FIREBASE_PROJECT_ID=fitness-app-e0aab


# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# Anthropic. Required for food photo recognition - Claude is the only
# vision-capable model in the routing table - and acts as the fallback for
# plan generation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# NVIDIA NIM. Optional but strongly recommended: structured generation
# (workouts, meal plans, recipes) routes here first at roughly a tenth of the
# token cost, falling back to Claude on failure. https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# Optional overrides.
# NVIDIA_NIM_STRUCTURED_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct

# Set to 1 to send structured generation to Claude instead of NIM. Useful for
# comparing output quality against the cost saving on real traffic.
# AI_PREFER_QUALITY=0


# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

# Server-only RevenueCat webhook, v1 API, identity hashing, and canonical
# product mapping. Product IDs must match the RevenueCat dashboard exactly.
REVENUECAT_WEBHOOK_SECRET=replace-with-the-exact-configured-authorization-header
REVENUECAT_SECRET_API_KEY=replace-with-a-secret-server-api-key
REVENUECAT_SUBJECT_HASH_KEY=replace-with-at-least-32-random-bytes
REVENUECAT_PRO_ENTITLEMENT_ID=Elovia Pro
REVENUECAT_COACHING_ENTITLEMENT_ID=Elovia Coaching
REVENUECAT_PRO_PRODUCTS_JSON=[{"id":"elovia_pro_monthly","kind":"auto_renewing"}]
REVENUECAT_COACHING_PRODUCTS_JSON=[{"id":"elovia_coaching_monthly","kind":"auto_renewing"}]
REVENUECAT_ENVIRONMENT=production
REVENUECAT_NORMALIZED_READS=per_user


# ---------------------------------------------------------------------------
# Operational configuration
# ---------------------------------------------------------------------------

# Expo push access token. Without it push still works, but anyone who learns a
# device token could send notifications to that device.
# https://expo.dev/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# NODE_ENV=production

# --- Coaching -------------------------------------------------------------
# Signs the short-lived calendar (.ics) links. The operating system opens those
# URLs itself and carries none of the app's auth headers, so the authorisation
# has to live in the URL. Any random string of 32+ characters will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: if unset, a key is derived from DATABASE_URL, which is stable but
# invalidates every outstanding link whenever the database URL changes.
LINK_SIGNING_SECRET=

# --- Google sign-in (required for production readiness) -------------------
# The server runs the OAuth exchange, so it needs BOTH halves of the Google
# credential. The client ID is public (it also ships in the app binary); the
# secret is not and must never be committed.
# The secret also derives a purpose-separated AES key for encrypting the
# short-lived provider token used by the native one-time exchange. Raw Google
# credentials never enter an app/custom-scheme callback URL or the database.
# From console.cloud.google.com -> APIs & Services -> Credentials.
# The OAuth client must list https://YOUR-DOMAIN/api/auth/google-callback as an
# authorised redirect URI, or Google rejects the request before it reaches us.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public hostname used to build the OAuth callback URL. Optional on Railway,
# which injects RAILWAY_PUBLIC_DOMAIN; set it explicitly anywhere else.
PUBLIC_DOMAIN=

# Must match expo.scheme. Leave as elovia unless the native app scheme changes.
MOBILE_APP_SCHEME=elovia
